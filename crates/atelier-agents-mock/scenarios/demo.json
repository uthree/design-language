{
  "stream": {"chunk": 6, "delay_ms": 30},
  "limits": {"five_hour": 62, "weekly": 35, "per_turn": 4},
  "rules": [
    {
      "when": {"read_only": true, "prompt_contains": "slow"},
      "reply": [
        {"think": "Taking my time."},
        {"sleep_ms": 5000},
        {"say": "Sorry for the wait. What should I plan?"}
      ]
    },
    {
      "when": {"prompt_contains": "fail"},
      "reply": [
        {"say": "Let me see..."},
        {"fail": "The mock provider is rate limited."}
      ]
    },
    {
      "when": {"read_only": true},
      "reply": [
        {"think": "The request is small: one step to write, one to test."},
        {"say": "Here is a plan in two steps.\n\n1. Add `greet()` to `src/lib.rs`.\n2. Add a test for it."}
      ]
    },
    {
      "when": {"prompt_contains": "greet"},
      "reply": [
        {"think": "Look at the crate first."},
        {"say": "Reading the crate."},
        {"tool": {"name": "Bash", "input": {"command": "ls src"}, "output": "lib.rs"}},
        {"tool": {"name": "Edit", "input": {"file_path": "src/lib.rs"}, "output": "Edited src/lib.rs", "ask": true}},
        {"say": "Done: `greet()` is in `src/lib.rs`."}
      ]
    }
  ],
  "otherwise": [
    {"say": "(mock) You said: {prompt}"}
  ]
}
